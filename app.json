{
  "expo": {
    "name": "FamilyStyle",
    "slug": "FamilyStyle",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/clean-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pratikpatel.familystyle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "dark": {
          "image": "./assets/clean-splash-dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#1c1514"
        }
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FamilyStyle to access your camera to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FamilyStyle to access your photos to select receipt images."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow FamilyStyle to access your contacts to add friends to your split."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c634ba78-a220-4036-9761-c24796c0b0ea"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c634ba78-a220-4036-9761-c24796c0b0ea",
      "enabled": true
    }
  }
}
